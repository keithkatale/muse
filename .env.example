# fal.ai Image Generation
# Get your API key from: https://fal.ai/dashboard/keys
FAL_KEY=your_fal_key_here

# Google Vertex AI / Gemini Enterprise Agent Platform
# Set these to use Vertex AI instead of the Gemini Developer API
# Enable the Vertex AI API in your Google Cloud project:
#   https://console.cloud.google.com/ai/enablement
# Authenticate with: gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# (Optional) Fallback: Gemini Developer API key
# If Vertex AI is not configured, the app falls back to this API key
# Get your API key from: https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=your_google_api_key_here

# Shopify Admin API Configuration (for creating draft orders)
# Get these from your Shopify admin: Settings > Apps and sales channels > Develop apps > Admin API
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_your_token_here
SHOPIFY_API_VERSION=2024-01

# Klaviyo Email Marketing Configuration
# Get your API keys from Klaviyo: Settings > API Keys
KLAVIYO_PRIVATE_API_KEY=pk_your_private_key_here
NEXT_PUBLIC_KLAVIYO_COMPANY_ID=your_company_id_here

